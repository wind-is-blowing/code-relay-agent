OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-max
OPENAI_API_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=
OPENAI_ENABLE_THINKING=true
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=6144
OPENAI_CONTEXT_WINDOW=16384
AGENT_MAX_CONTEXT_TOKENS=7000
AGENT_MAX_TURNS=60
AGENT_CIRCUIT_BREAKER_ENABLED=true
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_RECOVERY_SECONDS=30
# Avoid sending the old local-only embedding model to the new chat API.
RAG_EMBEDDING_PROVIDER=hashing
RAG_RERANK_PROVIDER=feature
