OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3.5:4b
OPENAI_API_KEY=ollama
# API profiles can select a separate secret, e.g. OPENAI_API_KEY_ENV=DASHSCOPE_API_KEY.
# OPENAI_ENABLE_THINKING=true
# AGENT_MAX_TURNS=60
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_CONTEXT_WINDOW=16384
AGENT_MAX_CONTEXT_TOKENS=9000
AGENT_CIRCUIT_BREAKER_ENABLED=true
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_RECOVERY_SECONDS=30

# RAG 默认使用无需下载模型的离线特征向量和交叉特征重排。
# 使用 OpenAI/Ollama 兼容 Embedding 服务时设置 openai 和模型名。
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_HASH_DIMENSIONS=384

# 可选：feature、sentence-transformers 或 http。
RAG_RERANK_PROVIDER=feature
RAG_RERANK_MODEL=
RAG_RERANK_URL=
RAG_RERANK_API_KEY=
